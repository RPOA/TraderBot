# Shared
WEBHOOK_SECRET=change-me-generate-with-secrets-token-urlsafe
LOG_LEVEL=INFO

# Trader
TRADER_PORT=8080
HYPERLIQUID_NETWORK=testnet
TRADE_DIRECTION=all
TRADE_DIRECTION_WEBHOOK_ENABLED=true
CLOSE_ON_TREND_CHANGE=true
DEFAULT_LEVERAGE=2.0
DEFAULT_COLLATERAL_PERCENTAGE=10.0
# Overridden to /app/... inside docker compose
WALLETS_FILE=
TICKERS_FILE=
DATA_DIR=
LOG_DIR=

# Watcher
WATCHER_PORT=8090
VNC_PORT=5900
TRADER_DO_TRADE_URL=http://trader:8080/do_trade
TRADER_TREND_URL=http://trader:8080/trend
WEBHOOK_RETRIES=3
TRADINGVIEW_URL=https://www.tradingview.com/ideas/
CHROME_HEADLESS=false
CHROME_PROFILE_DIR=
ALERT_CHECK_INTERVAL=1
ALERT_MAX_AGE_MINUTES=5
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
TRADE_ALERT_NAMES=BotTradeAlert
TREND_ALERT_NAMES=TREND
SELECTOR_ALERTS_BUTTON=[data-name="alerts"]
SELECTOR_ALERTS_CONTAINER=[data-name="widgetbar-pages-with-tabs"]
SELECTOR_LOG_TAB=button#log
SELECTOR_USER_MENU=button[aria-label*="menu"]
